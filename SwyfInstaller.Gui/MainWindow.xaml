<ui:FluentWindow x:Class="SwyfInstaller.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SWYF Custom AI Installer" Width="640" Height="560"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SWYF Custom AI Installer" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,12">
            <StackPanel>
                <TextBlock Text="SWYF Custom AI Installer" FontSize="20" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                    <TextBlock Text="{Binding InstalledLabel}" FontSize="11" Foreground="#6b7280" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="#4b5563" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <ui:Button Content="{Binding UpdateButtonText}" Command="{Binding DownloadAndInstallUpdateCommand}"
                               Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                               Margin="8,0,0,0" Padding="8,2" FontSize="11" Appearance="Primary" />
                </StackPanel>

                <TextBlock Text="Game folder" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding GameDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Scam With Your Friends folder" Margin="0,0,8,0" />
                    <ui:Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseGameDirCommand}" Margin="0,0,8,0" Padding="10,5" />
                    <ui:Button Grid.Column="2" Content="Detect" Command="{Binding DetectGameDirCommand}" Padding="10,5" />
                </Grid>
                <TextBlock Text="{Binding GameFolderStatus}" FontSize="11" Foreground="#6b7280" Margin="0,0,0,12" TextWrapping="Wrap" />

                <WrapPanel Orientation="Horizontal">
                    <ui:Button Content="Install" Command="{Binding InstallCommand}" Appearance="Primary" Margin="0,0,8,8" Padding="20,6" />
                    <ui:Button Content="Update" Command="{Binding UpdateModCommand}" Margin="0,0,8,8" Padding="20,6" />
                    <ui:Button Content="Uninstall" Command="{Binding UninstallCommand}" Margin="0,0,8,8" Padding="20,6" />
                    <ui:Button Content="Cancel" Command="{Binding CancelRunCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,8,8" Padding="20,6" />
                </WrapPanel>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,4,0,4"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="After installing, host a lobby and press F8 in-game to set up your AI." FontSize="11" Foreground="#6b7280" TextWrapping="Wrap" Margin="0,0,0,8" />

                <Border Padding="10" CornerRadius="6" BorderBrush="#22ffffff" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Recommended setup (enter in F8)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock FontSize="11" Foreground="#9ca3af" TextWrapping="Wrap">
                            Base URL <Run FontFamily="Consolas" Text="https://openrouter.ai/api/v1" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#9ca3af" TextWrapping="Wrap">
                            Model <Run FontFamily="Consolas" Text="meta-llama/llama-3.3-70b-instruct" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,2,0,0">
                            Key: <Hyperlink NavigateUri="https://openrouter.ai/workspaces/default/keys" RequestNavigate="Link_RequestNavigate">create one here</Hyperlink>
                            — shown only once, copy it right away.
                        </TextBlock>
                        <ui:Button Content="Copy setup" Command="{Binding CopyRecommendedCommand}" Padding="10,3" FontSize="11"
                                   Margin="0,6,0,0" HorizontalAlignment="Left"
                                   ToolTip="Copy the recommended base URL, model and key link." />
                    </StackPanel>
                </Border>

                <Expander Header="Details" Foreground="#6b7280" FontSize="11">
                    <StackPanel>
                        <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" AcceptsReturn="True"
                                 Height="150" VerticalScrollBarVisibility="Auto"
                                 Background="#0d1117" Foreground="#e6edf3"
                                 TextChanged="LogBox_TextChanged" />
                        <ui:Button Content="Copy log" Command="{Binding CopyLogCommand}" Padding="10,3" FontSize="11"
                                   Margin="0,6,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>

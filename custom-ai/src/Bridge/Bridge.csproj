<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>SWYF.CustomAI.Bridge</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net471" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="UnityEngine.CoreModule;UnityEngine.UIElementsModule;UnityEngine.UnityWebRequestModule;Unity.InputSystem;Mirror;Newtonsoft.Json;UniTask;PocketTTS">
      <HintPath>$(GameManaged)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set SWYF_GAME_DIR or pass -p:GameDir to your game installation folder." />
  </Target>
</Project>
